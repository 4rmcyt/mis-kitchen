{
  "default": {
    "paths": [
      "e2e/features/auth.feature",
      "e2e/features/today.feature",
      "e2e/features/add_task.feature",
      "e2e/features/recipes.feature",
      "e2e/features/lineup.feature",
      "e2e/features/admin.feature",
      "e2e/features/admin_templates.feature",
      "e2e/features/admin_recipes.feature",
      "e2e/features/improvements.feature",
      "e2e/features/rota.feature",
      "e2e/features/skills.feature",
      "e2e/features/velocity.feature",
      "e2e/features/report.feature",
      "e2e/features/push.feature"
    ],
    "tags": "not @manual",
    "import": ["e2e/support/world.js", "e2e/steps/**/*.js"],
    "format": ["html:e2e/reports/report.html"]
  },
  "mobile": {
    "paths": ["e2e/features/layout.feature"],
    "import": ["e2e/support/world.js", "e2e/steps/**/*.js"],
    "format": ["html:e2e/reports/mobile-report.html"]
  },
  "invite": {
    "paths": ["e2e/features/invite_onboarding.feature"],
    "import": ["e2e/support/world.js", "e2e/steps/**/*.js"],
    "format": ["html:e2e/reports/invite-report.html"]
  }
}
