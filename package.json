{
  "name": "mis-kitchen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node_modules/.bin/vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "cucumber-js",
    "test:e2e:ui": "E2E_HEADLESS=false cucumber-js",
    "test:mobile": "E2E_VIEWPORT=mobile cucumber-js --profile mobile",
    "test:mobile:ui": "E2E_HEADLESS=false E2E_VIEWPORT=mobile cucumber-js --profile mobile",
    "test:invite": "cucumber-js --profile invite",
    "test:invite:ui": "E2E_HEADLESS=false cucumber-js --profile invite"
  },
  "dependencies": {
    "@sentry/react": "^10.53.1",
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "wrangler": "^4.94.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
